{
  "$schema": "https://biomejs.dev/schemas/2.2.4/schema.json",
  "assist": {
    "enabled": false
  },
  "formatter": {
    "enabled": false
  },
  "linter": {
    "enabled": true,
    "rules": {
      "recommended": false,
      "a11y": {
        "recommended": false
      },
      "complexity": {
        "recommended": false
      },
      "correctness": {
        "noConstAssign": "error",
        "noInvalidUseBeforeDeclaration": "error",
        "noUnreachable": "error",
        "noUnsafeFinally": "error",
        "noUnsafeOptionalChaining": "error",
        "noUnusedLabels": "error",
        "useIsNan": "error",
        "useValidTypeof": "error"
      },
      "performance": {
        "recommended": false
      },
      "security": {
        "noDangerouslySetInnerHtml": "off",
        "noGlobalEval": "error"
      },
      "style": {
        "recommended": false
      },
      "suspicious": {
        "noDebugger": "error",
        "noDuplicateClassMembers": "error",
        "noDuplicateObjectKeys": "error",
        "noDuplicateParameters": "error",
        "noSelfCompare": "error"
      }
    }
  }
}
